# Chave da API da Anthropic (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-coloque-sua-chave-aqui

# Modelo usado pelo agente (pode trocar por outro modelo disponível na sua conta)
ANTHROPIC_MODEL=claude-sonnet-5-5

# Segredo usado para assinar a sessão (use uma string longa e aleatória)
SESSION_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Credenciais do login da aplicação
APP_USERNAME=admin
APP_PASSWORD=troque-esta-senha

# Servidor
PORT=3000
NODE_ENV=development
# Coloque true somente se estiver atrás de HTTPS (cookies "secure")
COOKIE_SECURE=false
# Coloque true se estiver atrás de um proxy reverso (Nginx, Render, etc.)
TRUST_PROXY=false

# Banco de dados (SQLite) e limites de segurança
DB_PATH=./data/loja.db
MAX_ROWS=200
QUERY_TIMEOUT_MS=5000
